  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Pre-request script runs before each request",
          "console.log('Request to:', pm.request.url.toString());"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Test script runs after each request",
          "console.log('Response status:', pm.response.code);",
          "",
          "// Auto-save auth token from login responses",
          "if (pm.request.url.toString().includes('/sign-in')) {",
          "    try {",
          "        const jsonData = pm.response.json();",
          "        if (jsonData.token) {",
          "            pm.collectionVariables.set('auth_token', jsonData.token);",
          "            console.log('Auth token saved!');",
          "        }",
          "        if (jsonData.user && jsonData.user.id) {",
          "            pm.collectionVariables.set('user_id', jsonData.user.id);",
          "            console.log('User ID saved:', jsonData.user.id);",
          "        }",
          "    } catch (e) {",
          "        console.log('Not a JSON response or no token found');",
          "    }",
          "}"
        ]
      }
    }
  ]
}
