# backend/.env.example
# Copy: cp .env.example .env.local  (development)
# Production: paste ke Railway Variables (lihat komentar di bawah)

NODE_ENV=development
PORT=8000

# URLs — local: localhost | production: domain Vercel + Railway kamu
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
BETTER_AUTH_URL=http://localhost:8000
TRUSTED_ORIGINS=http://localhost:3000

SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SUPABASE_DB_URL=postgresql://postgres.[ref]:[password]@aws-0-region.pooler.supabase.com:6543/postgres
PGSSL=false

BETTER_AUTH_SECRET=your_secret_min_32_chars

# Email — production Railway: pakai Resend (Gmail SMTP sering diblokir Railway)
# User awam TIDAK daftar Resend; hanya tim dev yang setup API key ini.

RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM_NAME=CuanSelor
# Setelah domain diverifikasi di https://resend.com/domains (wajib untuk kirim ke email user mana pun):
RESEND_FROM_EMAIL=onboarding@resend.dev
# Contoh setelah verify domain: RESEND_FROM_EMAIL=noreply@subdomain-kamu.com

# Gmail — opsional, biasanya hanya jalan di localhost (bukan Railway)
# GMAIL_USER=
# GMAIL_APP_PASSWORD=

REQUIRE_EMAIL_VERIFICATION=true

GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# streamlit-ds FastAPI (local :8001 | production: URL Railway service calculator)
PROJECTION_SERVICE_URL=http://127.0.0.1:8001
PROJECTION_TIMEOUT_MS=120000
PYTHON_COMMAND=python

AI_SERVICE_URL=https://your-ai-service.up.railway.app
AI_SERVICE_TIMEOUT_MS=15000
GEMINI_API_KEY=your_gemini_api_key

RATE_LIMIT_MAX=100
