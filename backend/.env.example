NODE_ENV=development
PORT=8000

FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
BETTER_AUTH_URL=http://localhost:8000
BETTER_AUTH_SECRET=replace-with-a-long-random-secret

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:your-password@aws-0-region.pooler.supabase.com:6543/postgres

# Set false only for local Postgres without SSL.
PGSSL=true

# Optional OAuth provider.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional comma-separated extra trusted origins.
TRUSTED_ORIGINS=

# Optional projection runtime tuning.
PYTHON_COMMAND=python
PROJECTION_TIMEOUT_MS=30000

# AI engineer FastAPI service. Jalankan service AI di port berbeda dari backend.
AI_SERVICE_URL=http://127.0.0.1:8001
AI_SERVICE_TIMEOUT_MS=15000

# Rate limiting (per IP).
# Global: max request dalam window waktu (ms).
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
# Khusus endpoint /api/projection (spawn Python — lebih ketat).
PROJECTION_RATE_LIMIT_MAX=10

# Email verification.
# Set ke true di production setelah konfigurasi email provider di better-auth.
# Selama development, biarkan false (default).
REQUIRE_EMAIL_VERIFICATION=false
