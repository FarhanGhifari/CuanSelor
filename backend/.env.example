# Server Configuration
PORT=8000

# Supabase Configuration
# Dapatkan ini di Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
# PENTING: Gunakan 'service_role' secret, BUKAN 'anon public' key
# Backend butuh bypass RLS untuk akses penuh ke database
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Better Auth & JWT
# Generate random string untuk production (min 32 characters)
BETTER_AUTH_SECRET=your_secret_key_here_min_32_chars

# Database Connection
# Format: postgresql://postgres.[project-ref]:[password]@[host]:6543/postgres
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:your-password@aws-0-region.pooler.supabase.com:6543/postgres

# SSL Configuration
PGSSL=false

# Projection lokal via streamlit-ds FastAPI (/calculate).
PROJECTION_SERVICE_URL=http://127.0.0.1:8001
PYTHON_COMMAND=python
PROJECTION_TIMEOUT_MS=120000

# AI engineer FastAPI service untuk risk profile (/predict).
AI_SERVICE_URL=https://cc26-capstone-ai-production-e2d1.up.railway.app
AI_SERVICE_TIMEOUT_MS=15000
