# FastAPI Server Configuration
HOST=0.0.0.0
PORT=8001

# Calculator Configuration
# Number of Monte Carlo simulations
# - 2000: Fast (dev) - ~0.5-0.8 seconds
# - 5000: Balanced - ~1.1-1.3 seconds
# - 10000: Accurate (production) - ~2.5-3.5 seconds
# IMPORTANT: Must match with Streamlit app for consistent results
N_SIMULATIONS=10000

# CORS Configuration
# Add allowed origins separated by comma
CORS_ORIGINS=http://localhost:3000,http://localhost:5000
